@0=~Vous voyez un fiélon trapu dont les écailles écarlates brillent à la lumière. Il semble être un abishaï rouge. L'un de ses yeux est gonflé et presque fermé, et l'une de ses ailes pend mollement. Il porte plusieurs blessures fraîches. Lorsqu'il vous voit, il sursaute. « Oh, merde. Pas encore. »~
@2=~« Encore ? Qu'est-ce que ça veut dire ? »~
@3=~« Salutations. Qui es-tu ? »~
@4=~« Je ne veux rien de toi. Adieu. »~
@6=~Le fiélon rouge vous regarde avec méfiance. « Quoi encore ? »~
@8=~« Je suis prêt à t'aider. »~
@9=~« J'ai quelques questions. »~
@10=~« Je voulais seulement te revoir. Adieu. »~
@12=~Le fiélon vous regarde avec méfiance. Il semble attendre quelque chose.~
@14=~« Je suis prêt. »~
@15=~« Pas encore. J'ai quelques questions. »~
@16=~« Pas encore. Adieu. »~
@18=~Le fiélon rouge vous regarde avec méfiance. « T'as survécu. »~
@20=~« Oui. Et je suis revenu comme promis. »~
@21=~« Oui. J'ai quelques questions. »~
@22=~« Oui. Adieu. »~
@24=~« Moi, c'est Tergush'tekhn. » Il secoue la tête et grimace de douleur. « Et toi, t'es... ? »~
@26=~« Je ne connais pas mon nom. »~
@27=~Mentir : « Adahn. »~
@29=~« Sans nom ? Pratique. Les noms donnent du pouvoir. Mais dans ton cas, j'imagine qu'on a déjà assez de choses à exploiter. »~
@31=~« De quoi parles-tu ? »~
@32=~« J'ai quelques questions. »~
@33=~« Je vais partir. »~
@35=~« Adahn ? » Le fiélon plisse les yeux. « Ça sonne faux. Mais peu importe. »~
@37=~« De quoi parlais-tu quand tu as dit “pas encore” ? »~
@38=~« J'ai quelques questions. »~
@39=~« Je vais partir. »~
@41=~« Les humains qui arrivent ici finissent généralement mal. Certains sont sacrifiés, d'autres deviennent esclaves, et quelques-uns sont simplement mangés. T'as l'air... différent. Mais je pensais quand même que t'étais venu pour moi. »~
@43=~« Pourquoi quelqu'un voudrait te capturer ? »~
@44=~« Qu'est-ce qui t'est arrivé ? »~
@45=~« J'ai quelques questions. »~
@46=~« Je vais partir. »~
@48=~Tergush'tekhn grogne. « Parce que j'ai déserté. Et dans les Neuf Enfers, les déserteurs ne vivent pas longtemps. »~
@50=~« Déserté quoi ? »~
@51=~« Pourquoi ? »~
@52=~« J'ai quelques questions. »~
@53=~« Je vais partir. »~
@55=~« La guerre. La Guerre Sanglante. Comme si y avait une autre guerre qui comptait. »~
@57=~« Tu étais soldat ? »~
@58=~« Pourquoi as-tu déserté ? »~
@59=~« J'ai quelques questions. »~
@60=~« Je vais partir. »~
@62=~« Soldat, oui. Chair à canon, surtout. Nous autres abishaïs, on est nombreux et faciles à remplacer. On nous envoie là où ça brûle le plus fort et on nous demande de tenir jusqu'à ce que quelque chose de plus important arrive. »~
@64=~« Et tu en as eu assez. »~
@65=~« Pourquoi as-tu déserté ? »~
@66=~« J'ai quelques questions. »~
@67=~« Je vais partir. »~
@69=~« J'ai vu trop de choses. Des légions entières broyées pour gagner quelques mètres d'un champ de bataille que personne ne voulait vraiment. J'ai vu des cornugons hurler des ordres pendant que les plus petits mouraient à leur place. J'ai vu des pit fiends envoyer des milliers de soldats dans des pièges juste pour voir si l'ennemi en avait posé. » Il renifle. « Et un jour, j'ai décidé que ma peau valait plus que leur stratégie. »~
@71=~« C'est compréhensible. »~
@72=~« C'est lâche. »~
@73=~« J'ai quelques questions. »~
@74=~« Je vais partir. »~
@76=~Le fiélon hausse les épaules. « Appelle ça comme tu veux. Je suis toujours vivant. La plupart de mes camarades ne le sont pas. »~
@78=~« Tu pourrais peut-être m'aider à ton tour. »~
@79=~« J'ai quelques questions. »~
@80=~« Je vais partir. »~
@82=~« Ça dépend. » Il vous examine de la tête aux pieds. « Qu'est-ce que tu veux ? »~
@84=~« Je cherche un portail vers Cania. »~
@85=~« Je cherche une érinye nommée Fury. »~
@86=~« Je cherche quelqu'un qui connaît Méphistar. »~
@87=~« Je cherche un moyen de survivre au froid de Cania. »~
@88=~« J'ai quelques questions. »~
@89=~« Je vais partir. »~
@91=~À la mention de Cania, Tergush'tekhn cesse de plaisanter. « T'es sérieux ? »~
@93=~« Oui. »~
@94=~« Très sérieux. »~
@96=~« Alors t'es fou. » Il marque une pause. « Mais j'imagine que c'est ton problème. »~
@98=~« Tu peux m'aider ? »~
@99=~« J'ai quelques questions. »~
@100=~« Je vais partir. »~
@102=~« Peut-être. Je connais un portail. Enfin... je connais *une façon* de le trouver. Mais ça va pas être simple. »~
@104=~« Je t'écoute. »~
@105=~« J'ai quelques questions d'abord. »~
@106=~« Je vais y réfléchir. »~
@108=~« Il y a quelque temps, une bande de voleurs hommes-rats a attaqué un marraénoloth qui transportait quelque chose de précieux. Ils ont réussi leur coup, mais une partie du butin les a conduits à un portail vers Cania. L'un d'eux en est revenu avec la queue gelée jusqu'à l'os. »~
@110=~« Et tu sais où ils sont ? »~
@111=~« Qu'est-ce qu'ils ont volé ? »~
@112=~« J'ai quelques questions. »~
@113=~« Je vais partir. »~
@115=~« Pas exactement. Les yugoloths les cherchent aussi. Mais si tu retrouves celui qui porte les engelures, tu trouveras probablement le portail. »~
@117=~« Où commencer ? »~
@118=~« J'ai quelques questions. »~
@119=~« Je vais partir. »~
@121=~« Les hommes-rats traînent autour du Rat and Splat. Essaie là-bas. »~
@123=~« Et le portail, il faut une clé ? »~
@124=~« J'ai quelques questions. »~
@125=~« Je vais partir. »~
@127=~« Tous les portails en ont une. Mais j'ignore laquelle. Le type à la queue gelée devrait peut-être le savoir. »~
@129=~« Tu as dit pouvoir m'aider à survivre au froid. »~
@130=~« J'ai quelques questions. »~
@131=~« Je vais partir. »~
@133=~« J'ai quelque chose. » Tergush'tekhn fouille sous ses ailes et en sort une robe sombre, épaisse, couverte de symboles infernaux. « Ça appartenait à un mage qui a eu la mauvaise idée de croire qu'un abishaï blessé était une proie facile. Elle protège contre le froid. Pas assez pour te rendre invincible, mais mieux que rien. »~
@135=~« Tu me la donnes ? »~
@136=~« Combien tu en veux ? »~
@137=~« J'ai quelques questions. »~
@138=~« Je vais partir. »~
@140=~« Si tu m'aides d'abord. »~
@142=~« À faire quoi ? »~
@143=~« J'ai quelques questions. »~
@144=~« Je vais partir. »~
@146=~« J'ai besoin de quitter cet endroit. Les agents de Molikroth me cherchent. J'ai entendu parler d'un portail qui mène hors de Cania, mais il me faut une clé. Un truc appelé Möbius. »~
@148=~« Möbius ? »~
@149=~« Où est cette clé ? »~
@150=~« J'ai quelques questions. »~
@151=~« Je vais partir. »~
@153=~« Un objet. Une sorte de bande tordue qui n'a qu'une face, si tu peux croire ça. Les modrones aiment ce genre de choses. »~
@155=~« Et où dois-je la trouver ? »~
@156=~« J'ai quelques questions. »~
@157=~« Je vais partir. »~
@159=~« Dans les environs de Méphistar. Un marchand appelé Mawu en a une, d'après ce que j'ai entendu. »~
@161=~« Qui est Mawu ? »~
@162=~« Pourquoi n'y vas-tu pas toi-même ? »~
@163=~« J'ai quelques questions. »~
@164=~« Je vais partir. »~
@166=~« Un marchand. Il vend tout ce qui peut être vendu, et probablement quelques trucs qui ne devraient pas l'être. »~
@168=~« Et toi, tu ne peux pas simplement lui acheter le Möbius ? »~
@169=~« J'ai quelques questions. »~
@170=~« Je vais partir. »~
@172=~« Je peux pas m'approcher de Méphistar sans me faire repérer. Molikroth a des yeux partout. Toi, en revanche... t'es assez bizarre pour qu'on te prenne pour un autre voyageur perdu. »~
@174=~« Donc je récupère le Möbius et tu me donnes la robe. »~
@175=~« J'ai quelques questions. »~
@176=~« Je vais partir. »~
@178=~« Exact. Et si tu survis assez longtemps pour revenir, je te dirai tout ce que je sais sur Fury. »~
@180=~« Tu connais Fury ? »~
@181=~« J'ai quelques questions. »~
@182=~« Je vais partir. »~
@184=~Le fiélon hésite. « Je l'ai vue. Une érinye en armure rouge. Belle, même pour une érinye. Elle travaille... ou travaillait... près de Méphistar. Elle avait des liens avec Levistus. »~
@186=~« Où est-elle maintenant ? »~
@187=~« Quelle relation avec Levistus ? »~
@188=~« J'ai quelques questions. »~
@189=~« Je vais partir. »~
@191=~« J'en sais pas davantage. Si elle est encore à Méphistar, quelqu'un là-bas le saura. »~
@193=~« Très bien. J'accepte ton marché. »~
@194=~« Je vais y réfléchir. »~
@196=~« Bien. » Tergush'tekhn vous tend la robe. « Prends-la maintenant. Si tu me trahis, j'aurai de toute façon d'autres problèmes à régler. »~
@198=~« Je reviendrai avec le Möbius. »~
@200=~« Tergush'tekhn, j'ai le Möbius. »~
@202=~Le fiélon se redresse malgré ses blessures. « Donne-le-moi. »~
@204=~Lui donner le Möbius.~
@205=~« Avant ça, réponds à mes questions sur Fury. »~
@206=~« J'ai changé d'avis. »~
@208=~Tergush'tekhn saisit l'objet avec un soulagement évident. « Enfin. »~
@209=~Pendant un instant, il le fait tourner entre ses griffes, fasciné par sa géométrie impossible. Puis il le glisse rapidement dans une poche de sa ceinture.~
@211=~« Et maintenant, Fury. »~
@212=~« Où vas-tu ? »~
@213=~« Nous sommes quittes. Adieu. »~
@215=~« Comme je te l'ai dit, Fury était liée à Levistus. Je l'ai vue plusieurs fois près de Méphistar, toujours en armure rouge. Elle était l'une de ses agents, peut-être davantage. Les rumeurs disent qu'elle lui était particulièrement dévouée. »~
@217=~« Elle est encore à Méphistar ? »~
@218=~« Pourquoi dis-tu “était” ? »~
@219=~« J'ai d'autres questions. »~
@220=~« Adieu. »~
@222=~« Parce que dans les Enfers, les alliances changent vite. Et parce que Molikroth contrôle Cania maintenant. Ceux qui étaient fidèles à Levistus sont devenus suspects. Certains ont disparu. »~
@224=~« Tu crois qu'elle a été capturée ? »~
@225=~« Tu crois qu'elle a changé de camp ? »~
@226=~« J'ai d'autres questions. »~
@227=~« Adieu. »~
@229=~« Je sais pas. Mais si elle n'est pas morte, elle est probablement quelque part où Molikroth peut la surveiller. »~
@231=~« Et toi, où vas-tu avec le Möbius ? »~
@232=~« J'ai d'autres questions. »~
@233=~« Adieu. »~
@235=~« Loin d'ici. Il existe un portail qui devrait me conduire vers Avernus, ou peut-être Dis. Peu importe : n'importe où est mieux que Cania pour un déserteur. »~
@237=~« Bonne chance. »~
@239=~Le fiélon ricane. « La chance n'existe pas ici. Seulement les contrats et les couteaux dans le dos. Mais merci. »~
@241=~« J'ai quelques questions. »~
@242=~« Adieu. »~
@244=~« Qu'est-ce que tu veux savoir ? »~
@246=~« Parle-moi de Cania. »~
@247=~« Parle-moi de Méphistar. »~
@248=~« Qui est Molikroth ? »~
@249=~« Qui est Levistus ? »~
@250=~« Parle-moi des abishaïs. »~
@251=~« Parle-moi de la Guerre Sanglante. »~
@252=~« Tu connais un imp appelé Prod ? »~
@253=~« J'ai besoin d'un portail vers Cania. »~
@254=~« J'ai besoin de survivre au froid de Cania. »~
@255=~« Je cherche Fury. »~
@256=~« Laisse tomber. »~
@258=~« Cania est le huitième cercle de Baator. De la glace, du vent et des trucs enterrés qu'il vaut mieux laisser tranquilles. Le froid tue les mortels en quelques minutes si vous êtes pas préparés. Les gelugons y sont chez eux, et Méphistar domine la strate. »~
@260=~« Méphistar ? »~
@261=~« J'ai d'autres questions. »~
@262=~« Laisse tomber. »~
@264=~« La grande cité de Cania. Elle appartenait à Méphistophélès, puis Molikroth a pris le pouvoir. Des tours de glace, des ponts, des bibliothèques, des académies infernales... Tout ce qu'il faut pour rappeler que même les diables savants restent des diables. »~
@266=~« Qui est Molikroth ? »~
@267=~« J'ai d'autres questions. »~
@268=~« Laisse tomber. »~
@270=~« Le nouveau seigneur de Cania. Un baron énorme, glacial et paranoïaque. Il a renversé Méphistophélès et s'est installé à Méphistar. Au moins, c'est la version officielle. »~
@272=~« Tu n'y crois pas ? »~
@273=~« J'ai d'autres questions. »~
@274=~« Laisse tomber. »~
@276=~Tergush'tekhn regarde autour de lui et baisse la voix. « Disons seulement que dans Baator, les choses sont rarement aussi simples qu'elles en ont l'air. »~
@278=~« J'ai d'autres questions. »~
@279=~« Laisse tomber. »~
@281=~« Levistus est le seigneur emprisonné de Stygie, le cinquième cercle. Asmodeus l'a enfermé dans un bloc de glace pour trahison. Malgré ça, il continue à comploter, à envoyer ses agents partout et à rendre la vie difficile aux autres archidiables. »~
@283=~« Et Fury travaillait pour lui ? »~
@284=~« J'ai d'autres questions. »~
@285=~« Laisse tomber. »~
@287=~« Les abishaïs sont des baatezus mineurs. Cinq couleurs principales, chacune avec son rang. Les rouges comme moi sont les plus forts des abishaïs ordinaires. Ça veut surtout dire qu'on nous donne des tâches plus dangereuses et qu'on nous demande de sourire quand on meurt. »~
@289=~« Charmant système. »~
@290=~« J'ai d'autres questions. »~
@291=~« Laisse tomber. »~
@293=~« La Guerre Sanglante est la guerre éternelle entre baatezus et tanar'ris. Loi mauvaise contre chaos mauvais. Tout le monde prétend que l'enjeu est le destin du Multivers. Pour ceux qui combattent, l'enjeu est généralement de survivre au prochain assaut. »~
@295=~« Tu regrettes d'avoir déserté ? »~
@296=~« J'ai d'autres questions. »~
@297=~« Laisse tomber. »~
@299=~« Chaque jour où je me réveille encore vivant me rappelle que non. »~
@301=~« J'ai d'autres questions. »~
@302=~« Laisse tomber. »~
@304=~« Prod ? » Le fiélon éclate d'un rire douloureux. « Oui, je connais ce petit sac à problèmes. Il a servi de messager et d'éclaireur à plusieurs maîtres différents. Il survit surtout parce qu'il sait exactement quand fuir. »~
@306=~« Il est avec moi maintenant. »~
@307=~« J'ai d'autres questions. »~
@308=~« Laisse tomber. »~
@310=~« Alors garde un œil sur lui. Les imps ont toujours un plan. Même quand ils jurent que non. »~
@312=~« J'ai d'autres questions. »~
@313=~« Laisse tomber. »~
@315=~Le fiélon vous regarde avec une fascination nouvelle. « Tu veux vraiment aller en Cania. »~
@317=~« Oui. »~
@318=~« J'ai d'autres questions. »~
@319=~« Laisse tomber. »~
@321=~« Dans ce cas, écoute bien : trouve l'homme-rat à la queue gelée. Et prépare-toi contre le froid. »~
@323=~« J'ai d'autres questions. »~
@324=~« Laisse tomber. »~
@326=~« Je t'ai déjà donné ce que j'avais de mieux contre le froid. Si tu veux mieux, cherche des mages, des objets ou une bénédiction. Mais ne sous-estime jamais Cania. »~
@328=~« J'ai d'autres questions. »~
@329=~« Laisse tomber. »~
@331=~« Fury. » Tergush'tekhn semble réfléchir à ce nom plus longtemps que nécessaire. « Elle a une réputation. Elle est intelligente, dangereuse et fidèle... ou l'était. Une érinye qui porte une armure rouge et ne gaspille pas ses mots. »~
@333=~« Tu l'apprécies ? »~
@334=~« J'ai d'autres questions. »~
@335=~« Laisse tomber. »~
@337=~« Je préfère les gens qui parlent peu. Dans Baator, chaque phrase peut devenir une dette. »~
@339=~« J'ai d'autres questions. »~
@340=~« Laisse tomber. »~
@342=~« Je suis prêt à t'aider. »~
@344=~« Alors trouve le Möbius. Mawu devrait l'avoir. Reviens quand tu l'auras. »~
@346=~« D'accord. »~
@348=~« Je ne comprends toujours pas pourquoi tu ne peux pas le faire toi-même. »~
@350=~« Parce que je suis recherché, blessé et pas assez stupide pour me promener sous les fenêtres de Molikroth. Ça suffit comme raisons ? »~
@352=~« Oui. »~
@354=~« Bien. »~
@356=~Le fiélon pose sa griffe sur votre épaule. « Écoute. Si tu arrives à Méphistar, évite d'avoir l'air impressionné. Les diables adorent sentir qu'un visiteur a peur. Et évite de signer quoi que ce soit. »~
@358=~« Merci du conseil. »~
@360=~« Oh, et si quelqu'un te propose de rencontrer le Baron Molikroth en personne... »~
@362=~« Oui ? »~
@364=~« Refuse. »~
@366=~« Pourquoi ? »~
@368=~« Parce que ceux qui rencontrent Molikroth finissent souvent par ne plus être disponibles pour raconter comment ça s'est passé. »~
@370=~« Bon à savoir. »~
@372=~Tergush'tekhn grimace et ajuste son aile blessée. « Maintenant va. Plus tu restes, plus les chances augmentent que quelqu'un remarque que tu parles à un déserteur. »~
@374=~« Adieu. »~
@376=~Vous commencez à vous éloigner lorsque le fiélon vous rappelle. « Hé. »~
@378=~Vous retourner.~
@380=~Il vous lance un petit objet. Vous l'attrapez par réflexe. C'est une pièce d'un métal sombre, froide au toucher.~
@381=~« Si tu vois Mawu, montre-lui ça. Il saura que tu viens de ma part. Ça ne le rendra pas honnête, mais peut-être qu'il essaiera de te voler un peu moins. »~
@383=~« Merci. »~
@385=~« Ne me remercie pas encore. »~
@387=~Partir.~
